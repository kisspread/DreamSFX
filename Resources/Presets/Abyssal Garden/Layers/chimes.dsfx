sound abyssal.chimes
# 海底风铃
preview 20 s
clock 10 Hz
seed 20261110 mulberry32
input pitchScale range .5 2 default 1
resources {
  seaFloor=buffer.brown_loop(11s,random=mulberry32,crossfadeFrames=4096,step=.02,level=3.5)
  waterIR=impulse.diffuse(5s,random=mulberry32,dampingFloor=.04,dampingAmount=.5,dampingDecayPerSecond=2,attackSeconds=.03333333333333333,decaySeconds=.6666666666666666,taperEnd=1)
  skip fiveMutedDronePairs = 5
}

bus sea {
  master=gain(level=target(0,.78,1)) -> limiter=compressor(thresholdDb=-6,kneeDb=6,ratio=20,attackSeconds=.003,releaseSeconds=.3)
  room=room.convolution(ir=waterIR) -> master
}

bus chimeMix {
  level=gain(level=target(0,1,.25)) -> sea.master
  level -> gain(level=1.2) -> sea.room
}
voice chime[3] {
  pitch=sine(hz=440) -> amp=gain(level=0) -> side=pan(position=0) -> chimeMix.level
}

memory {
  noteAt=0; fromHz=0; toHz=0; duration=0; attack=0; peak=0
  chimeSlot=0; nextchime=5
}

start { all chime }

rule chimeDue {
  noteAt=now+.05; call chimeNote
  nextchime=noteAt+rand(2.5,9)
}
rule chimeNote {
  fromHz=440*pow(2,pick(floor(rand(0,9)),0,2,5,7,9,12,14,17,19)/12); toHz=fromHz
  duration=5; peak=rand(.02,.04); attack=.03
  chime[chimeSlot].side:position=rand(-.7,.7) at noteAt
  chime[chimeSlot].pitch:hz=keyexp(0,fromHz*pitchScale,duration,toHz*pitchScale) at noteAt
  chime[chimeSlot].amp:level=line(0,0,attack,peak) at noteAt
  chime[chimeSlot].amp:level=target(0,(duration-attack)/5) at noteAt+attack
  chimeSlot=wrap(chimeSlot+1,3)
}

state idle { tick update }
rule update { if time>0 then cycle }
rule cycle {
  if now+.05>nextchime then chimeDue
}
output sea.limiter
