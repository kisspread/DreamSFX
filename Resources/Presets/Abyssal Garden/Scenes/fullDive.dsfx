sound abyssal.fulldive
# 一分钟下潜
preview 60 s
clock 10 Hz
seed 20261110 mulberry32
input speedScale range .25 1.25 default 1
resources {
  seaFloor=buffer.brown_loop(11s,random=mulberry32,crossfadeFrames=4096,step=.02,level=3.5)
  waterIR=impulse.diffuse(5s,random=mulberry32,dampingFloor=.04,dampingAmount=.5,dampingDecayPerSecond=2,attackSeconds=.03333333333333333,decaySeconds=.6666666666666666,taperEnd=1)
}

bus sea {
  master=gain(level=target(0,.78,1)) -> limiter=compressor(thresholdDb=-6,kneeDb=6,ratio=20,attackSeconds=.003,releaseSeconds=.3)
  room=room.convolution(ir=waterIR) -> master
}

bus rumble {
  noise(buffer=seaFloor) -> lowpass(cutoffHz=150,q=.7) -> body=gain(level=.34) -> gain(level=target(0,1,.25)) -> sea.master
  sine(hz=.07) -> gain(level=.11) -> body:level
  sine(hz=.113) -> gain(level=.08) -> body:level
}

bus water {
  loop=noise(buffer=seaFloor,playbackRate=.63)
  loop -> bandpass(cutoffHz=420,q=.5) -> swell=gain(level=1) -> surface=gain(level=.25) -> gain(level=target(0,1,.25)) -> sea.master
  sine(hz=.09) -> gain(level=.3) -> swell:level
  sine(hz=.151) -> gain(level=.25) -> swell:level
  loop -> band=bandpass(cutoffHz=300,q=.9) -> swim=gain(level=0) -> gain(level=target(0,1,.25)) -> sea.master
}

bus fifths {
  mix=gain(level=target(0,1,.25)) -> sea.master
  mix -> gain(level=1.5) -> sea.room
}
voice string(root=[73.42,110,164.81,246.94,369.99]) {
  let beatHz=rand(.03,.11)
  sine(hz=root) -> pair=gain(level=.022-i*.003) -> fifths.mix
  sine(hz=root+beatHz) -> pair
}

bus bubbleMix {
  level=gain(level=target(0,1,.25)) -> sea.master
  level -> gain(level=0.12) -> sea.room
}
voice bubble[4] {
  pitch=sine(hz=440) -> amp=gain(level=0) -> side=pan(position=0) -> bubbleMix.level
}

bus chimeMix {
  level=gain(level=target(0,1,.25)) -> sea.master
  level -> gain(level=1.2) -> sea.room
}
voice chime[3] {
  pitch=sine(hz=440) -> amp=gain(level=0) -> side=pan(position=0) -> chimeMix.level
}

bus whaleMix {
  level=gain(level=target(0,1,.25)) -> sea.master
  level -> gain(level=2) -> sea.room
}
voice whale[2] {
  pitch=triangle(hz=440) -> amp=gain(level=0) -> side=pan(position=0) -> whaleMix.level
}

memory {
  noteAt=0; fromHz=0; toHz=0; duration=0; attack=0; peak=0
  bubbleSlot=0; nextbubble=1.5
  chimeSlot=0; nextchime=5
  whaleSlot=0; nextwhale=12
  cameraY=-8; velocity=0
}

start { all string; all bubble; all chime; all whale }

rule camera {
  cameraY=-3-21*min(1,time/50)
  velocity=speedScale*if(time>6 && time<13,24*sin(3.141592653589793*(time-6)/7),if(time>32 && time<38,18,0))
  water.surface:level=target(.25+.55*clamp(1+cameraY/30,0,1)^2,.5) at now+.05
  water.swim:level=target(.5*min(velocity/26,1)^1.2,.3) at now+.05
  water.band:cutoffHz=target(220+14*velocity,.3) at now+.05
}

rule bubbleDue {
  noteAt=now+.05; call bubblePhrase
  nextbubble=noteAt+rand(.5,5)
}
rule bubblePhrase { repeat floor(1+rand(0,1)*rand(0,1)*6) then bubbleNote }
rule bubbleNote {
  fromHz=rand(380,1300); toHz=fromHz*rand(1.4,2.2)
  duration=.05+40/fromHz; peak=rand(.03,.08); attack=.006
  bubble[bubbleSlot].side:position=rand(-.7,.7) at noteAt
  bubble[bubbleSlot].pitch:hz=keyexp(0,fromHz,duration,toHz) at noteAt
  bubble[bubbleSlot].amp:level=line(0,0,attack,peak) at noteAt
  bubble[bubbleSlot].amp:level=target(0,(duration-attack)/5) at noteAt+attack
  bubbleSlot=wrap(bubbleSlot+1,4)
  noteAt=noteAt+rand(.07,.2)
}

rule chimeDue {
  noteAt=now+.05; call chimeNote
  nextchime=noteAt+rand(2.5,9)
}
rule chimeNote {
  fromHz=440*pow(2,pick(floor(rand(0,9)),0,2,5,7,9,12,14,17,19)/12); toHz=fromHz
  duration=5; peak=rand(.02,.04); attack=.03
  chime[chimeSlot].side:position=rand(-.7,.7) at noteAt
  chime[chimeSlot].pitch:hz=keyexp(0,fromHz,duration,toHz) at noteAt
  chime[chimeSlot].amp:level=line(0,0,attack,peak) at noteAt
  chime[chimeSlot].amp:level=target(0,(duration-attack)/5) at noteAt+attack
  chimeSlot=wrap(chimeSlot+1,3)
}

rule whaleDue {
  noteAt=now+.05; call whalePhrase
  nextwhale=noteAt+rand(20,50)
}
rule whalePhrase { repeat floor(2+rand(0,2)) then whaleNote }
rule whaleNote {
  fromHz=rand(170,380); duration=rand(1.6,3.2); toHz=fromHz*rand(.6,1.7)
  peak=.08; attack=duration*.4
  whale[whaleSlot].side:position=rand(-.7,.7) at noteAt
  whale[whaleSlot].pitch:hz=keyexp(0,fromHz,duration,toHz) at noteAt
  whale[whaleSlot].amp:level=line(0,0,attack,peak) at noteAt
  whale[whaleSlot].amp:level=target(0,(duration-attack)/5) at noteAt+attack
  whaleSlot=wrap(whaleSlot+1,2)
  noteAt=noteAt+.8*duration
}

state idle { tick update }
rule update { if time>0 then cycle }
rule cycle {
  call camera
  if now+.05>nextbubble then bubbleDue
  if now+.05>nextchime then chimeDue
  if now+.05>nextwhale then whaleDue
}
output sea.limiter
