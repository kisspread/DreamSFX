sound abyssal.bubblesnow
# 立即冒出一串气泡
preview 4 s
clock 10 Hz
seed 20261110 mulberry32
input pitchScale range .5 2 default 1
resources {
  seaFloor=buffer.brown_loop(11s,random=mulberry32,crossfadeFrames=4096,step=.02,level=3.5)
  waterIR=impulse.diffuse(5s,random=mulberry32,dampingFloor=.04,dampingAmount=.5,dampingDecayPerSecond=2,attackSeconds=.03333333333333333,decaySeconds=.6666666666666666,taperEnd=1)
  skip fiveMutedDronePairs = 5
}

bus sea {
  master=gain(level=target(0,.78,1)) -> limiter=compressor(thresholdDb=-6,kneeDb=6,ratio=20,attackSeconds=.003,releaseSeconds=.3)
  room=room.convolution(ir=waterIR) -> master
}

bus bubbleMix {
  level=gain(level=target(0,1,.25)) -> sea.master
  level -> gain(level=0.12) -> sea.room
}
voice bubble[4] {
  pitch=sine(hz=440) -> amp=gain(level=0) -> side=pan(position=0) -> bubbleMix.level
}

memory {
  noteAt=0; fromHz=0; toHz=0; duration=0; attack=0; peak=0
  bubbleSlot=0; nextbubble=1.5
}

start { all bubble; noteAt=now+.05; call bubblePhrase }

rule bubbleDue {
  noteAt=now+.05; call bubblePhrase
  nextbubble=noteAt+rand(.5,5)
}
rule bubblePhrase { repeat floor(1+rand(0,1)*rand(0,1)*6) then bubbleNote }
rule bubbleNote {
  fromHz=rand(380,1300); toHz=fromHz*rand(1.4,2.2)
  duration=.05+40/fromHz; peak=rand(.03,.08); attack=.006
  bubble[bubbleSlot].side:position=rand(-.7,.7) at noteAt
  bubble[bubbleSlot].pitch:hz=keyexp(0,fromHz*pitchScale,duration,toHz*pitchScale) at noteAt
  bubble[bubbleSlot].amp:level=line(0,0,attack,peak) at noteAt
  bubble[bubbleSlot].amp:level=target(0,(duration-attack)/5) at noteAt+attack
  bubbleSlot=wrap(bubbleSlot+1,4)
  noteAt=noteAt+rand(.07,.2)
}

state idle { tick update }
rule update { if time>0 then cycle }
rule cycle {
  if now+.05>nextbubble then bubbleDue
}
output sea.limiter
