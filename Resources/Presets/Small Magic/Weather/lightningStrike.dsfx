sound small_magic.lightningstrike
preview 4 s
clock 100 Hz
seed 132721
input volume range .05 1 default .8
resources {
  # 主场先生成房间、三色噪声和颗粒。两套总线共用这条随机序列。
  skip roomAndWhite=595228
  pink=buffer.pink(3s)
  skip brownAndGrain=289920
  reflections=buffer.white(.9s)
  hiss=buffer.white(2s,channels=1)
}
bus world {
  mix=gain() -> hush=gain() -> ears=lowpass(cutoffHz=20000,q=.5) -> pre=gain(level=.5) -> compressor(thresholdDb=-6,kneeDb=6,ratio=8,attackSeconds=.003,releaseSeconds=.3) -> shape(drive=1.5,normalized=1,oversample2x=1) -> out=gain(level=target(.9,.9*volume,.03))
  beds=gain() -> mix
  noise(buffer=pink,offset=rand(0,2.5)) -> wind=lowpass(cutoffHz=420,q=.6) -> breeze=gain(level=.04) -> beds
  sine(hz=.07) -> gain(level=170) -> wind:cutoffHz
  sine(hz=.11*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
  sine(hz=.23*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
}
bus synth {
  sum=gain()
  input=gain(level=target(.8,.8*volume,.03)) -> compressor(thresholdDb=-10,kneeDb=4,ratio=4,attackSeconds=.003,releaseSeconds=.2) -> shape(drive=1.3,normalized=1) -> sum
  room=room.decaying_noise(noise=reflections,attackSeconds=.004,decaySeconds=.14285714285714285) -> gain(level=.35) -> input
  world.out -> sum
}

audition { at .3 cast }
state idle {}
state cast { enter launch }
memory { echoAt=0; cutoff=600; loud=.13 }
rule launch {
  play crack; play snap at now+.012; play rumble at now+.05; play rollMotion
  echoAt=now+.45; cutoff=600; loud=.13; play echo at echoAt
  echoAt=now+.95; cutoff=380; loud=.06; play echo at echoAt
}
voice crack {
  source.mono_noise_buffer(buffer=hiss,offset=rand(0,1.5),life=.05) -> highpass(cutoffHz=1800) -> level=gain(level=exp(0,.5,.045,.001)) -> synth.input
  level -> gain(level=.4) -> synth.room
}
voice snap {
  source.mono_noise_buffer(buffer=hiss,offset=rand(0,1.5),life=.388) -> bandpass(cutoffHz=exp(0,700,.338,120),q=1) -> gain(level=exp(0,.4,.368,.001)) -> synth.input
}
voice rumble {
  source.mono_noise_buffer(buffer=hiss,offset=rand(0,1.5),life=3.35) -> lowpass(cutoffHz=110,q=.8) -> sway=gain() -> gain(level=exp(0,.0001,.13,.5,3.25,.0008)) -> synth.input
}
voice rollMotion {
  sine(hz=.7,life=3.4) -> gain(level=.3) -> rumble.sway:level
  sine(hz=4.3,life=3.4) -> gain(level=.2) -> rumble.sway:level
}
voice echo[2] {
  source.mono_noise_buffer(buffer=hiss,offset=rand(0,1.5),life=.5) -> lowpass(cutoffHz=cutoff) -> level=gain(level=exp(0,loud,.5,.0008)) -> synth.input
  level -> gain(level=.3) -> synth.room
}
output synth.sum
