sound small_magic.rainonlake
preview 6.5 s
clock 100 Hz
seed 132721
input volume range .05 1 default .8
resources {
  # 主场先生成房间、三色噪声和颗粒。两套总线共用这条随机序列。
  skip roomAndWhite=595228
  pink=buffer.pink(3s)
  skip brownAndGrain=289920
  reflections=buffer.white(.9s)
  hiss=buffer.white(2s,channels=1)
}
bus world {
  mix=gain() -> hush=gain() -> ears=lowpass(cutoffHz=20000,q=.5) -> pre=gain(level=.5) -> compressor(thresholdDb=-6,kneeDb=6,ratio=8,attackSeconds=.003,releaseSeconds=.3) -> shape(drive=1.5,normalized=1,oversample2x=1) -> out=gain(level=target(.9,.9*volume,.03))
  beds=gain() -> mix
  noise(buffer=pink,offset=rand(0,2.5)) -> wind=lowpass(cutoffHz=420,q=.6) -> breeze=gain(level=.04) -> beds
  sine(hz=.07) -> gain(level=170) -> wind:cutoffHz
  sine(hz=.11*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
  sine(hz=.23*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
}
bus synth {
  sum=gain()
  input=gain(level=target(.8,.8*volume,.03)) -> compressor(thresholdDb=-10,kneeDb=4,ratio=4,attackSeconds=.003,releaseSeconds=.2) -> shape(drive=1.3,normalized=1) -> sum
  room=room.decaying_noise(noise=reflections,attackSeconds=.004,decaySeconds=.14285714285714285) -> gain(level=.35) -> input
  world.out -> sum
}

audition { at .3 cast }
state idle {}
state cast { enter launch }
memory { onset=0; pitch=1300; loudness=.05; notePan=0; splashPan=0; offset=0 }
rule launch { play lake; repeat 26 then drop; repeat 3 then heavyDrop }
rule drop {
  onset=now+.2+4.6*rand(0,1)^.6; pitch=rand(1300,3000)
  loudness=rand(.05,.12); notePan=rand(-.85,.85); splashPan=rand(-.85,.85); offset=rand(0,1.5)
  play small at onset
}
rule heavyDrop { onset=now+rand(.8,4.6); notePan=rand(-.6,.6); play heavy at onset }
bus lakeMix {
  surface=gain() -> synth.input
  surface -> gain(level=.3) -> synth.room
}
voice lake {
  source.mono_noise_buffer(buffer=hiss,playbackRate=.5,life=5.7) -> filter=lowpass(cutoffHz=300,q=.6) -> gain(level=exp(0,.0001,1.2,.07,5.6,.0001)) -> lakeMix.surface
  sine(hz=.4,life=6) -> gain(level=90) -> filter:cutoffHz
}
voice small[20] {
  sine@2(startAtZero=1,frequencyFromBlockStart=1,hz=exactexp(0,pitch,.05,pitch*.42),life=.12) -> gain(level=exp(0,loudness,.09,.0006)) -> pan(position=notePan) -> lakeMix.surface
  source.mono_noise_buffer(buffer=hiss,offset=offset,life=.05) -> highpass(cutoffHz=3200) -> gain(level=exp(0,.035,.03,.0005)) -> pan(position=splashPan) -> lakeMix.surface
}
voice heavy[3] {
  sine@2(startAtZero=1,frequencyFromBlockStart=1,hz=exactexp(0,300,.12,90),life=.2) -> gain(level=exp(0,.13,.16,.0006)) -> pan(position=notePan) -> lakeMix.surface
}
output synth.sum
