sound small_magic.frostpour
preview 8.5 s
clock 100 Hz
seed 132721
input volume range .05 1 default .8
resources {
  roomIR=impulse.room(3.2s)
  white=buffer.white(3s)
  pink=buffer.pink(3s)
  brown=buffer.brown(3s)
  emberWhite=buffer.white(.04s,channels=1)
  skip extraRoomAndHiss=182400
}
bus world {
  mix=gain() -> hush=gain() -> ears=lowpass(cutoffHz=20000,q=.5) -> pre=gain(level=.5) -> compressor(thresholdDb=-6,kneeDb=6,ratio=8,attackSeconds=.003,releaseSeconds=.3) -> shape(drive=1.5,normalized=1,oversample2x=1) -> out=gain(level=target(.9,.9*volume,.03))
  beds=gain() -> mix
  room=room(ir=roomIR) -> gain(level=.8) -> mix
  hills=echo(seconds=.71) -> ridge=lowpass(cutoffHz=1250,q=.5) -> gain(level=.85) -> mix
  ridge -> gain(level=.34) -> delay(seconds=128/48000) -> hills
  noise(buffer=pink,offset=rand(0,2.5)) -> wind=lowpass(cutoffHz=420,q=.6) -> breeze=gain(level=.04) -> beds
  sine(hz=.07) -> gain(level=170) -> wind:cutoffHz
  sine(hz=.11*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
  sine(hz=.23*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
}

input spread range 0 8 default 3.5
input distance range 0 100 default 21.93171219946131
input side range -1 1 default .069375729
input onWater range 0 1 default 0
audition { at .3 pour }
memory { age=0; crack=.15; boom=.6; unused=0; grown=0; level=1 }
state idle {}
state pour { enter pourStart; tick frost }
rule pourStart {
  level=.35+.65*max(0,1-distance/110)
  play jet; play onset
}
rule frost {
  age=age+dt
  grown=min(1,spread/5.5)
  jet.body:level=target(.75*min(1,age/.25),.08)
  ice.pan:position=target(.8*side,.1)
  ice.bus:level=target(1,.08)
  crack=crack-dt; boom=boom-dt
  if crack<=0 then newCrack
  if boom<=0 then fracture
}
# 裸合成试音使用等量的随机抽取，录音层没有参与混音。
rule newCrack {
  crack=rand(.14,.44)/(.6+.8*grown)
  unused=rand(.3,.8)+rand(.4,.85)+rand(-.3,.3)+rand(0,1)
}
rule fracture {
  boom=if(onWater>.5,.7,1.5)+rand(0,1)*if(onWater>.5,.8,1.5)
  unused=rand(.28,.48)+rand(0,1)
  play iceWeight
}
bus ice {
  bus=gain(level=0) -> pan=pan(position=0) -> world.mix
  pan -> gain(level=.35) -> world.room
}
voice jet {
  noise(buffer=white,offset=rand(0,2.5)) -> bandpass(cutoffHz=4200,q=.6) -> gain(level=target(0,.42,.08)) -> body=gain(level=0) -> pan=pan(position=0) -> world.mix
  noise(buffer=pink,offset=rand(0,2.5)) -> bandpass(cutoffHz=900,q=.7) -> gain(level=target(0,.4,.08)) -> body
  noise(buffer=brown,offset=rand(0,2.5)) -> lowpass(cutoffHz=170) -> gain(level=target(0,.85,.08)) -> body
  pan -> gain(level=.2) -> world.room
}
voice onset {
  noise(buffer=white,offset=rand(0,2.5),life=.5) -> highpass(cutoffHz=1800) -> gain(level=swell(.45,.6,.5)) -> front=gain() -> world.mix
  front -> gain(level=.2) -> world.room
}
patch weight {
  noise(buffer=brown,offset=rand(0,2.5),life=duration+.05) -> lowpass(cutoffHz=exp(0,260,duration*.6,55),q=.8) -> gain(level=exp(0,.0001,.006,weightLevel,duration,.0001)) -> shape(drive=3) -> outlet
}
voice iceWeight[2] -> ice.bus { use weight(weightLevel=level*if(onWater>.5,.7,.35),duration=.5) }
output world.out
