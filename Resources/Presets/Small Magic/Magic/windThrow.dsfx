sound small_magic.windthrow
preview 6 s
clock 100 Hz
seed 132721
input volume range .05 1 default .8
resources {
  roomIR=impulse.room(3.2s)
  white=buffer.white(3s)
  pink=buffer.pink(3s)
  brown=buffer.brown(3s)
  emberWhite=buffer.white(.04s,channels=1)
  skip extraRoomAndHiss=182400
}
bus world {
  mix=gain() -> hush=gain() -> ears=lowpass(cutoffHz=20000,q=.5) -> pre=gain(level=.5) -> compressor(thresholdDb=-6,kneeDb=6,ratio=8,attackSeconds=.003,releaseSeconds=.3) -> shape(drive=1.5,normalized=1,oversample2x=1) -> out=gain(level=target(.9,.9*volume,.03))
  beds=gain() -> mix
  room=room(ir=roomIR) -> gain(level=.8) -> mix
  hills=echo(seconds=.71) -> ridge=lowpass(cutoffHz=1250,q=.5) -> gain(level=.85) -> mix
  ridge -> gain(level=.34) -> delay(seconds=128/48000) -> hills
  noise(buffer=pink,offset=rand(0,2.5)) -> wind=lowpass(cutoffHz=420,q=.6) -> breeze=gain(level=.04) -> beds
  sine(hz=.07) -> gain(level=170) -> wind:cutoffHz
  sine(hz=.11*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
  sine(hz=.23*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
}

input charge range 0 1 default 1
audition { at .3 cast }
state idle {}
state cast { enter launch }
rule launch {
  world.pre:level=line(0,.5,.004,.5+.3*charge,.5,.5+.3*charge,1.6,.5)
  play weightHit; play pressure
}
bus air {
  impulse=gain(level=.6+.6*charge) -> filter.lowshelf(cutoffHz=120,gainDb=8) -> body=gain() -> world.mix
  body -> gain(level=.3) -> world.room
  body -> gain(level=.3) -> world.hills
}
patch weight {
  noise(buffer=brown,offset=rand(0,2.5),life=duration+.05) -> lowpass(cutoffHz=exp(0,260,duration*.6,55),q=.8) -> gain(level=exp(0,.0001,.006,weightLevel,duration,.0001)) -> shape(drive=3) -> outlet
}
voice weightHit -> air.impulse { use weight(weightLevel=.9+.6*charge,duration=.8) }
voice pressure {
  noise(buffer=pink,offset=rand(0,2.5),life=1.4) -> bandpass(cutoffHz=exp(0,700,1,180),q=.7) -> gain(level=exp(0,.0001,.05,1,1.3,.0001)) -> air.impulse
  noise(buffer=white,offset=rand(0,2.5),life=.65) -> highpass(cutoffHz=2500) -> gain(level=exp(0,.0001,.04,.3,.6,.0001)) -> air.impulse
}
output world.out
