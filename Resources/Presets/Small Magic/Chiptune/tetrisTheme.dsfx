sound small_magic.tetristheme
preview 11.5 s
clock 100 Hz
seed 132721
input volume range .05 1 default .8
resources {
  # 主场先生成房间、三色噪声和颗粒。两套总线共用这条随机序列。
  skip roomAndWhite=595228
  pink=buffer.pink(3s)
  skip brownAndGrain=289920
  reflections=buffer.white(.9s)
  hiss=buffer.white(2s,channels=1)
}
bus world {
  mix=gain() -> hush=gain() -> ears=lowpass(cutoffHz=20000,q=.5) -> pre=gain(level=.5) -> compressor(thresholdDb=-6,kneeDb=6,ratio=8,attackSeconds=.003,releaseSeconds=.3) -> shape(drive=1.5,normalized=1,oversample2x=1) -> out=gain(level=target(.9,.9*volume,.03))
  beds=gain() -> mix
  noise(buffer=pink,offset=rand(0,2.5)) -> wind=lowpass(cutoffHz=420,q=.6) -> breeze=gain(level=.04) -> beds
  sine(hz=.07) -> gain(level=170) -> wind:cutoffHz
  sine(hz=.11*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
  sine(hz=.23*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
}
bus synth {
  sum=gain()
  input=gain(level=target(.8,.8*volume,.03)) -> compressor(thresholdDb=-10,kneeDb=4,ratio=4,attackSeconds=.003,releaseSeconds=.2) -> shape(drive=1.3,normalized=1) -> sum
  room=room.decaying_noise(noise=reflections,attackSeconds=.004,decaySeconds=.14285714285714285) -> gain(level=.35) -> input
  world.out -> sum
}

audition { at .3 cast }
state idle {}
state cast { enter launch }
# 传统民歌 Korobeiniki，采用本地试听页的双声部合成编排。
input speed range .65 1.6 default 1
memory { note=0; melodyBeat=0; bassBeat=0; bars=0; pitch=0; beats=1; leadTime=.3; bassPitch=82.41 }
rule launch { repeat 19 then firstLine; note=0; repeat 18 then secondLine; repeat 10 then bar }
rule firstLine {
  pitch=pick(note,659.26,493.88,523.25,587.33,523.25,493.88,440,440,523.25,659.26,587.33,523.25,493.88,523.25,587.33,659.26,523.25,440,440)
  beats=pick(note,1,.5,.5,1,.5,.5,1,.5,.5,1,.5,.5,1.5,.5,1,1,1,1,1.5)
  call leadNote
}
rule secondLine {
  pitch=pick(note,587.33,698.46,880,783.99,698.46,659.26,523.25,659.26,587.33,523.25,493.88,493.88,523.25,587.33,659.26,523.25,440,440)
  beats=pick(note,1.5,.5,1,.5,.5,1.5,.5,1,.5,.5,1,.5,.5,1,1,1,1,1.5)
  call leadNote
}
rule leadNote { leadTime=.32*.92*beats/speed; play lead at now+melodyBeat*.32/speed; melodyBeat=melodyBeat+beats; note=note+1 }
rule bar { bassPitch=pick(bars,82.41,110,123.47,82.41,110,146.83,130.81,123.47,110,82.41); repeat pick(bars,4,4,4,2,2,4,4,4,2,2) then bassNote; bars=bars+1 }
rule bassNote { play bass at now+bassBeat*.32/speed; bassBeat=bassBeat+1 }
voice lead[8] {
  square(hz=pitch,life=leadTime+.02) -> tone=gain(level=exp(0,.11,leadTime,.0008)) -> synth.input
  tone -> gain(level=.06) -> synth.room
}
voice bass[8] {
  triangle(hz=bassPitch,life=.304/speed+.02) -> gain(level=exp(0,.15,.304/speed,.0008)) -> synth.input
}
output synth.sum
