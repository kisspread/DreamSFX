sound small_magic.bubblesunder
preview 5.5 s
clock 100 Hz
seed 132721
input volume range .05 1 default .8
resources {
  # 主场先生成房间、三色噪声和颗粒。两套总线共用这条随机序列。
  skip roomAndWhite=595228
  pink=buffer.pink(3s)
  skip brownAndGrain=289920
  reflections=buffer.white(.9s)
  hiss=buffer.white(2s,channels=1)
}
bus world {
  mix=gain() -> hush=gain() -> ears=lowpass(cutoffHz=20000,q=.5) -> pre=gain(level=.5) -> compressor(thresholdDb=-6,kneeDb=6,ratio=8,attackSeconds=.003,releaseSeconds=.3) -> shape(drive=1.5,normalized=1,oversample2x=1) -> out=gain(level=target(.9,.9*volume,.03))
  beds=gain() -> mix
  noise(buffer=pink,offset=rand(0,2.5)) -> wind=lowpass(cutoffHz=420,q=.6) -> breeze=gain(level=.04) -> beds
  sine(hz=.07) -> gain(level=170) -> wind:cutoffHz
  sine(hz=.11*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
  sine(hz=.23*rand(.9,1.1)) -> gain(level=.015) -> breeze:level
}
bus synth {
  sum=gain()
  input=gain(level=target(.8,.8*volume,.03)) -> compressor(thresholdDb=-10,kneeDb=4,ratio=4,attackSeconds=.003,releaseSeconds=.2) -> shape(drive=1.3,normalized=1) -> sum
  room=room.decaying_noise(noise=reflections,attackSeconds=.004,decaySeconds=.14285714285714285) -> gain(level=.35) -> input
  world.out -> sum
}

audition { at .3 cast }
state idle {}
state cast { enter launch }
memory { at=0; pitch=250; rise=1; riseTime=.05; loudness=.04; side=0 }
rule launch { play bed; repeat 20 then pop; repeat 3 then deep }
rule pop {
  at=now+.3+4*rand(0,1)^.8; pitch=rand(250,1000); rise=rand(1.5,2.3)
  riseTime=rand(.05,.11); loudness=rand(.04,.09); side=rand(-.9,.9)
  play bubble at at
}
rule deep { play large at now+rand(1,4) }
voice bed {
  source.mono_noise_buffer(buffer=hiss,offset=rand(0,1.5),life=4.8) -> lowpass(cutoffHz=480,q=.7) -> wobble=gain() -> gain(level=exp(0,.0001,.8,.075,4.7,.0006)) -> synth.input
  sine(hz=.5,life=4.8) -> gain(level=.35) -> wobble:level
  sine(hz=62,life=4.7) -> gain(level=exp(0,.0001,1,.05,4.6,.0006)) -> synth.input
}
voice bubble[12] {
  sine@2(startAtZero=1,frequencyFromBlockStart=1,hz=exactexp(0,pitch,riseTime,pitch*rise),life=.16) -> gain(level=exp(0,loudness,.12,.0005)) -> pan(position=side) -> synth.input
}
voice large[3] {
  sine@2(startAtZero=1,frequencyFromBlockStart=1,hz=exactexp(0,160,.22,420),life=.24) -> level=gain(level=exp(0,.12,.22,.0008)) -> synth.input
  level -> gain(level=.1) -> synth.room
}
output synth.sum
